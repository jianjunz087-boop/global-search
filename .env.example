# Server PostgreSQL connection; omit when using embedded local mode.
# DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/baihua
# Persistent local PostgreSQL-compatible PGlite (do not run concurrent server processes on this path).
DESKTOP_DATA_DIR=/workspace/.baihua-data
# Optional real search and Google Trends via SerpAPI; server only.
# Set your own key locally, then restart the server. Never send keys in chat.
SERPAPI_API_KEY=
